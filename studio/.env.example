# Copy to .env on the server. Never commit .env.
STUDIO_USER=hammad
STUDIO_PASSWORD=change-me
STUDIO_POLL_SECONDS=3
# Optional: Groq Whisper (free tier). Without it the worker uses local faster-whisper (slow on 1 vCPU).
GROQ_API_KEY=
# Optional: Netscape cookie file for yt-dlp, mounted read-only from ./secrets
STUDIO_COOKIES_FILE=/secrets/instagram-cookies.txt
# Required for the lesson stage (S3)
ANTHROPIC_API_KEY=
# Optional overrides
STUDIO_MODEL=claude-opus-5-5
STUDIO_EFFORT=high
# STUDIO_LESSON_LANGUAGE=English   # default: the language of the reference
# Required for the avatar stage (S4): HeyGen → Settings → API
HEYGEN_API_KEY=
# STUDIO_HEYGEN_LOOK_ID=        # from `run_local.sh heygen-looks`; default: the look named STUDIO_HEYGEN_LOOK_NAME
# STUDIO_HEYGEN_LOOK_NAME=Hammad Yousuf
