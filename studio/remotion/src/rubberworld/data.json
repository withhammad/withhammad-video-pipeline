{
"frames": 1742,
"standin": false,
"lines": [
{
"i": 0,
"who": "G",
"text": "Ugh. Claude, my last video got six views.",
"start": 0.1,
"end": 3.3,
"tempo": 1.0,
"drift": -0.05
},
{
"i": 1,
"who": "C",
"text": "Six?",
"start": 3.42,
"end": 4.12,
"tempo": 1.029,
"drift": 0.075
},
{
"i": 2,
"who": "C",
"text": "Videos like this one pull millions.",
"start": 4.24,
"end": 5.62,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 3,
"who": "G",
"text": "Wait. You made that?",
"start": 5.74,
"end": 7.32,
"tempo": 1.0,
"drift": -0.296
},
{
"i": 4,
"who": "C",
"text": "That one, and fifty-five more. Every frame is code.",
"start": 7.44,
"end": 10.66,
"tempo": 1.0,
"drift": -0.254
},
{
"i": 5,
"who": "G",
"text": "Okay. Nobody ever shows how. Show me.",
"start": 10.78,
"end": 13.68,
"tempo": 1.0,
"drift": -0.156
},
{
"i": 6,
"who": "C",
"text": "Step one. Give me one line.",
"start": 13.8,
"end": 15.4,
"tempo": 1.0,
"drift": -0.072
},
{
"i": 7,
"who": "G",
"text": "Um. What if all rubber disappeared for five seconds?",
"start": 15.555,
"end": 18.415,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 8,
"who": "C",
"text": "I searched. Almost nobody's posted that.",
"start": 19.035,
"end": 21.575,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 9,
"who": "C",
"text": "Step two. I find a source for every fact.",
"start": 21.695,
"end": 23.835,
"tempo": 1.0,
"drift": -0.373
},
{
"i": 10,
"who": "G",
"text": "And then you generate the video?",
"start": 24.315,
"end": 25.795,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 11,
"who": "C",
"text": "Nope. Not an AI video model. I write code that builds the whole world.",
"start": 26.269,
"end": 30.641,
"tempo": 1.02,
"drift": -0.4
},
{
"i": 12,
"who": "C",
"text": "Times Square. Three hundred fifty-two cars.",
"start": 30.761,
"end": 33.101,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 13,
"who": "G",
"text": "But I can't code.",
"start": 33.221,
"end": 34.301,
"tempo": 1.0,
"drift": -0.062
},
{
"i": 14,
"who": "C",
"text": "You never write a line.",
"start": 34.421,
"end": 35.361,
"tempo": 1.0,
"drift": -0.214
},
{
"i": 15,
"who": "C",
"text": "Step four. I check my own frames, and fix what's weak.",
"start": 35.53,
"end": 38.3,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 16,
"who": "C",
"text": "Step five. Your laptop renders it, in Blender. Seventeen hundred frames.",
"start": 38.982,
"end": 44.019,
"tempo": 1.144,
"drift": -0.4
},
{
"i": 17,
"who": "G",
"text": "Okay. How much does that cost?",
"start": 44.139,
"end": 45.919,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 18,
"who": "C",
"text": "Blender is free. Claude Code runs on your Pro plan.",
"start": 46.039,
"end": 48.859,
"tempo": 1.0,
"drift": -0.066
},
{
"i": 19,
"who": "G",
"text": "That's it?",
"start": 48.979,
"end": 49.679,
"tempo": 1.0,
"drift": -0.041
},
{
"i": 20,
"who": "C",
"text": "That's it. Five steps.",
"start": 49.799,
"end": 51.139,
"tempo": 1.0,
"drift": -0.036
},
{
"i": 21,
"who": "G",
"text": "Comment WORLD, and I'll send you the full tutorial.",
"start": 53.75,
"end": 56.89,
"tempo": 1.0,
"drift": -0.1
}
],
