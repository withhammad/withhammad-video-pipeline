{
"frames": 1742,
"standin": false,
"lines": [
{
"i": 0,
"who": "G",
"text": "Ugh. Claude, my last video got six views.",
"start": 0.1,
"end": 3.475,
"tempo": 1.022,
"drift": -0.05
},
{
"i": 1,
"who": "C",
"text": "Six?",
"start": 3.595,
"end": 4.205,
"tempo": 1.18,
"drift": 0.25
},
{
"i": 2,
"who": "C",
"text": "Videos like this one pull millions.",
"start": 4.325,
"end": 5.705,
"tempo": 1.0,
"drift": 0.335
},
{
"i": 3,
"who": "G",
"text": "Wait. You made that?",
"start": 5.825,
"end": 7.365,
"tempo": 1.0,
"drift": -0.211
},
{
"i": 4,
"who": "C",
"text": "That one, and fifty-five more. Every frame is code.",
"start": 7.485,
"end": 10.705,
"tempo": 1.0,
"drift": -0.209
},
{
"i": 5,
"who": "G",
"text": "Okay. Nobody ever shows how. Show me.",
"start": 10.825,
"end": 13.395,
"tempo": 1.0,
"drift": -0.111
},
{
"i": 6,
"who": "C",
"text": "Step one. Give me one line.",
"start": 13.515,
"end": 15.115,
"tempo": 1.0,
"drift": -0.357
},
{
"i": 7,
"who": "G",
"text": "Um. What if all rubber disappeared for five seconds?",
"start": 15.555,
"end": 19.255,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 8,
"who": "C",
"text": "I searched. Almost nobody's posted that.",
"start": 19.375,
"end": 21.915,
"tempo": 1.0,
"drift": -0.06
},
{
"i": 9,
"who": "C",
"text": "Step two. I find a source for every fact.",
"start": 22.035,
"end": 24.175,
"tempo": 1.0,
"drift": -0.033
},
{
"i": 10,
"who": "G",
"text": "And then you generate the video?",
"start": 24.315,
"end": 26.225,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 11,
"who": "C",
"text": "Nope. Not an AI video model. I write code that builds the whole world.",
"start": 26.345,
"end": 30.641,
"tempo": 1.038,
"drift": -0.324
},
{
"i": 12,
"who": "C",
"text": "Times Square. Three hundred fifty-two cars.",
"start": 30.761,
"end": 33.101,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 13,
"who": "G",
"text": "But I can't code.",
"start": 33.221,
"end": 34.691,
"tempo": 1.0,
"drift": -0.062
},
{
"i": 14,
"who": "C",
"text": "You never write a line.",
"start": 34.811,
"end": 35.751,
"tempo": 1.0,
"drift": 0.176
},
{
"i": 15,
"who": "C",
"text": "Step four. I check my own frames, and fix what's weak.",
"start": 35.871,
"end": 38.641,
"tempo": 1.0,
"drift": -0.059
},
{
"i": 16,
"who": "C",
"text": "Step five. Your laptop renders it, in Blender. Seventeen hundred frames.",
"start": 38.982,
"end": 44.019,
"tempo": 1.144,
"drift": -0.4
},
{
"i": 17,
"who": "G",
"text": "Okay. How much does that cost?",
"start": 44.139,
"end": 46.486,
"tempo": 1.18,
"drift": 0.25
},
{
"i": 18,
"who": "C",
"text": "Blender is free. Claude Code runs on your Pro plan.",
"start": 46.606,
"end": 49.15,
"tempo": 1.109,
"drift": 0.501
},
{
"i": 19,
"who": "G",
"text": "That's it?",
"start": 49.27,
"end": 50.194,
"tempo": 1.18,
"drift": 0.25
},
{
"i": 20,
"who": "C",
"text": "That's it. Five steps.",
"start": 50.314,
"end": 51.449,
"tempo": 1.18,
"drift": 0.479
},
{
"i": 21,
"who": "G",
"text": "Comment WORLD, and I'll send you the full tutorial.",
"start": 53.75,
"end": 57.21,
"tempo": 1.0,
"drift": -0.1
}
],
