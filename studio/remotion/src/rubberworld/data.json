{
"frames": 1742,
"standin": false,
"lines": [
{
"i": 0,
"who": "G",
"text": "Ugh. Claude, my last video got six views.",
"start": 0.1,
"end": 3.3,
"tempo": 1.0,
"drift": -0.05
},
{
"i": 1,
"who": "C",
"text": "Six?",
"start": 3.42,
"end": 4.12,
"tempo": 1.0,
"drift": 0.075
},
{
"i": 2,
"who": "C",
"text": "Videos like this one pull millions.",
"start": 4.24,
"end": 5.98,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 3,
"who": "G",
"text": "Wait. You made that?",
"start": 6.1,
"end": 7.68,
"tempo": 1.0,
"drift": 0.064
},
{
"i": 4,
"who": "C",
"text": "That one, and fifty-five more. Every frame is code.",
"start": 7.8,
"end": 11.066,
"tempo": 1.047,
"drift": 0.106
},
{
"i": 5,
"who": "G",
"text": "Okay. Nobody ever shows how. Show me.",
"start": 11.186,
"end": 14.002,
"tempo": 1.03,
"drift": 0.25
},
{
"i": 6,
"who": "C",
"text": "Step one. Give me one line.",
"start": 14.122,
"end": 15.802,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 7,
"who": "G",
"text": "Um. What if all rubber disappeared for five seconds?",
"start": 15.922,
"end": 18.782,
"tempo": 1.0,
"drift": -0.033
},
{
"i": 8,
"who": "C",
"text": "I searched. Almost nobody's posted that.",
"start": 19.035,
"end": 21.575,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 9,
"who": "C",
"text": "Step two. I find a source for every fact.",
"start": 21.695,
"end": 24.315,
"tempo": 1.0,
"drift": -0.373
},
{
"i": 10,
"who": "G",
"text": "And then you generate the video?",
"start": 24.435,
"end": 25.915,
"tempo": 1.0,
"drift": -0.28
},
{
"i": 11,
"who": "C",
"text": "Nope. Not an AI video model. I write code that builds the whole world.",
"start": 26.269,
"end": 30.641,
"tempo": 1.002,
"drift": -0.4
},
{
"i": 12,
"who": "C",
"text": "Times Square. Three hundred fifty-two cars.",
"start": 30.761,
"end": 32.741,
"tempo": 1.0,
"drift": 0.25
},
{
"i": 13,
"who": "G",
"text": "But I can't code.",
"start": 32.883,
"end": 33.963,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 14,
"who": "C",
"text": "You never write a line.",
"start": 34.235,
"end": 35.215,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 15,
"who": "C",
"text": "Step four. I check my own frames, and fix what's weak.",
"start": 35.53,
"end": 38.2,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 16,
"who": "C",
"text": "Step five. Your laptop renders it, in Blender. Seventeen hundred frames.",
"start": 38.982,
"end": 43.422,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 17,
"who": "G",
"text": "Okay. How much does that cost?",
"start": 43.542,
"end": 45.322,
"tempo": 1.0,
"drift": -0.347
},
{
"i": 18,
"who": "C",
"text": "Blender is free. Claude Code runs on your Pro plan.",
"start": 45.705,
"end": 48.405,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 19,
"who": "G",
"text": "That's it?",
"start": 48.62,
"end": 49.32,
"tempo": 1.0,
"drift": -0.4
},
{
"i": 20,
"who": "C",
"text": "That's it. Five steps.",
"start": 49.44,
"end": 50.76,
"tempo": 1.0,
"drift": -0.395
},
{
"i": 21,
"who": "G",
"text": "Comment WORLD, and I'll send you the full tutorial.",
"start": 53.75,
"end": 56.89,
"tempo": 1.0,
"drift": -0.1
}
],
