  "captions": [
    {
      "start": 0.52,
      "end": 2.52,
      "text": "السلام علیکم، میں حماد"
    },
    {
      "start": 2.56,
      "end": 4.7,
      "text": "ہوں۔ آج ہم ایک عام بولتی"
    },
    {
      "start": 4.74,
      "end": 5.84,
      "text": "ہوئی ویڈیو کو موشن"
    },
    {
      "start": 5.9,
      "end": 7.3,
      "text": "گرافکس کے ساتھ ایڈٹ کرنے"
    },
    {
      "start": 7.38,
      "end": 8.6,
      "text": "کا پورا طریقہ دیکھیں گے۔"
    },
    {
      "start": 9.3,
      "end": 10.76,
      "text": "پہلے ہم ویڈیو کا مقصد"
    },
    {
      "start": 10.78,
      "end": 11.92,
      "text": "اور ویژول اسٹائل واضح"
    },
    {
      "start": 12.0,
      "end": 13.54,
      "text": "کریں گے، پھر کلاڈ میں"
    },
    {
      "start": 13.58,
      "end": 14.76,
      "text": "فوٹیج اور ہدایات دیں گے،"
    },
    {
      "start": 15.16,
      "end": 16.7,
      "text": "اور آخر میں تیار نتیجہ"
    },
    {
      "start": 16.74,
      "end": 18.56,
      "text": "چیک کریں گے۔ میں اپنی اے"
    },
    {
      "start": 18.62,
      "end": 19.88,
      "text": "آئی اوتار ویڈیو اور اپنی"
    },
    {
      "start": 20.0,
      "end": 21.32,
      "text": "کلون آواز استعمال کر رہا"
    },
    {
      "start": 21.36,
      "end": 22.98,
      "text": "ہوں، تاکہ آپ سورس اور"
    },
    {
      "start": 23.02,
      "end": 24.2,
      "text": "فائنل ایڈٹ کا فرق خود"
    },
    {
      "start": 24.24,
      "end": 25.2,
      "text": "دیکھ سکیں۔"
    },
    {
      "start": 25.521505376344084,
      "end": 28.159139784946234,
      "text": "सबसे पहले चैट जी पी टी में अपनी"
    },
    {
      "start": 28.22795698924731,
      "end": 31.1752688172043,
      "text": "वीडियो का विषय और उसका मकसद साफ़ करें।"
    },
    {
      "start": 31.347311827956986,
      "end": 33.29784946236559,
      "text": "सिर्फ़ यह न कहें कि वीडियो अच्छी बना"
    },
    {
      "start": 33.36666666666667,
      "end": 36.26451612903226,
      "text": "दो। बताएं कि आपको किस तरह के ग्राफ़िक्स,"
    },
    {
      "start": 36.47096774193548,
      "end": 39.774193548387096,
      "text": "कौन से रंग, और कितने विज़ुअल मोमेंट्स चाहिए।"
    },
    {
      "start": 40.09569892473118,
      "end": 43.215053763440864,
      "text": "यहाँ हमारी मिसाल कैंपेन प्लानिंग की है, इसलिए"
    },
    {
      "start": 43.26129032258065,
      "end": 45.754838709677415,
      "text": "हर ग्राफ़िक किसी एक बात को समझाएगा।"
    },
    {
      "start": 45.9010752688172,
      "end": 48.76774193548387,
      "text": "एक रास्ता साफ़ सुथरे कार्ड्स और डायग्राम्स का"
    },
    {
      "start": 48.83655913978494,
      "end": 51.84946236559139,
      "text": "है, दूसरा ज़्यादा नुमायाँ टाइपोग्राफ़ी का।"
    },
    {
      "start": 52.04838709677419,
      "end": 54.961290322580645,
      "text": "हम वह अंदाज़ चुनेंगे जिसमें बात आसानी से"
    },
    {
      "start": 55.03010752688172,
      "end": 57.20967741935483,
      "text": "पढ़ी जा सके और प्रेज़ेंटर भी नज़र आता"
    },
    {
      "start": 57.27849462365592,
      "end": 61.20215053763441,
      "text": "रहे। स्टोरीबोर्ड में पहले मकसद, फिर ऑडियंस, फिर"
    },
    {
      "start": 61.248387096774195,
      "end": 63.86322580645161,
      "text": "चार अलग काम, और आखिर में टेस्टिंग और"
    },
    {
      "start": 63.90860215053763,
      "end": 65.28494623655914,
      "text": "रिव्यू दिखाया गया है।"
    },
    {
      "start": 65.42258064516129,
      "end": 67.9005376344086,
      "text": "यह तस्वीरें एडिट की दिशा बताती हैं, यह"
    },
    {
      "start": 67.94623655913978,
      "end": 69.59354838709677,
      "text": "ख़ुद तैयार वीडियो नहीं हैं।"
    },
    {
      "start": 69.91,
      "end": 70.58,
      "text": "اب ہمارے پاس"
    },
    {
      "start": 70.63999999999999,
      "end": 71.82,
      "text": "سورس ویڈیو اور اسٹوری"
    },
    {
      "start": 71.86,
      "end": 73.66,
      "text": "بورڈ موجود ہیں۔ یہاں ایک"
    },
    {
      "start": 73.71999999999998,
      "end": 75.49999999999999,
      "text": "فرق واضح کر دوں: ریفرنس"
    },
    {
      "start": 75.53999999999999,
      "end": 76.71999999999998,
      "text": "کا پرائیویٹ ایڈٹنگ سکل"
    },
    {
      "start": 76.75999999999999,
      "end": 78.33999999999999,
      "text": "دستیاب نہیں تھا، اس لیے"
    },
    {
      "start": 78.37999999999998,
      "end": 79.58,
      "text": "ہم نے اسی کام کے لیے"
    },
    {
      "start": 79.64,
      "end": 80.96,
      "text": "اپنا الگ ورک فلو بنایا"
    },
    {
      "start": 81.71999999999998,
      "end": 83.02,
      "text": "ہے۔ اس میں آواز کی اصل"
    },
    {
      "start": 83.05999999999999,
      "end": 84.14,
      "text": "ٹائمنگ محفوظ رہتی ہے،"
    },
    {
      "start": 84.49999999999999,
      "end": 85.71999999999998,
      "text": "اور گرافکس بولے جانے"
    },
    {
      "start": 85.75999999999999,
      "end": 87.15999999999998,
      "text": "والے الفاظ کے مطابق آتے"
    },
    {
      "start": 87.19999999999999,
      "end": 89.24,
      "text": "ہیں۔ صرف اچھا دکھنا کافی"
    },
    {
      "start": 89.27999999999999,
      "end": 90.55999999999999,
      "text": "نہیں، ایڈٹ کو بات"
    },
    {
      "start": 90.61999999999999,
      "end": 91.69999999999999,
      "text": "سمجھانی بھی چاہیے۔"
    },
    {
      "start": 92.11397849462364,
      "end": 94.77516129032259,
      "text": "अब क्लॉड खोलें और मॉडल मेन्यू में ओपस"
    },
    {
      "start": 94.91290322580645,
      "end": 96.88602150537633,
      "text": "पाँच दशमलव पाँच चुनें।"
    },
    {
      "start": 97.0236559139785,
      "end": 99.61505376344084,
      "text": "प्लस मेन्यू से एडिटिंग स्किल शामिल करें।"
    },
    {
      "start": 99.73010752688171,
      "end": 103.85913978494622,
      "text": "हमारे अकाउंट में अपना बनाया हुआ हम्माद वीडियो"
    },
    {
      "start": 103.85913978494622,
      "end": 104.1806451612903,
      "text": "एडिटिंग स्किल मौजूद है।"
    },
    {
      "start": 104.34193548387097,
      "end": 108.37849462365591,
      "text": "इसके बाद असल सोर्स वीडियो, स्टोरीबोर्ड और कैप्शन"
    },
    {
      "start": 108.42473118279568,
      "end": 110.38602150537633,
      "text": "की टाइमिंग वाली फ़ाइल अपलोड करें।"
    },
    {
      "start": 110.48924731182794,
      "end": 113.56344086021502,
      "text": "प्रॉम्प्ट में साफ़ लिखें कि आवाज़ और वीडियो"
    },
    {
      "start": 113.60860215053762,
      "end": 115.59247311827957,
      "text": "की लंबाई महफ़ूज़ रहनी चाहिए।"
    },
    {
      "start": 115.78602150537634,
      "end": 118.60752688172042,
      "text": "ग्राफ़िक्स उसी वक़्त आएं जब संबंधित बात बोली"
    },
    {
      "start": 118.67634408602149,
      "end": 121.01612903225805,
      "text": "जा रही हो, और कोई नए आँकड़े या"
    },
    {
      "start": 121.06236559139782,
      "end": 122.0,
      "text": "दावे शामिल न किए जाएं।"
    },
    {
      "start": 122.0,
      "end": 122.85698924731182,
      "text": "दावे शामिल न किए जाएं।"
    },
    {
      "start": 123.01935483870969,
      "end": 125.8643010752688,
      "text": "दस अच्छे विज़ुअल मोमेंट्स माँगने का मतलब दस"
    },
    {
      "start": 126.0021505376344,
      "end": 129.3505376344086,
      "text": "बेवजह इफ़ेक्ट्स नहीं, बल्कि दस जगहों पर बात"
    },
    {
      "start": 129.44301075268817,
      "end": 130.73763440860213,
      "text": "को साफ़ करना है।"
    },
    {
      "start": 130.9021505376344,
      "end": 134.02236559139786,
      "text": "अगर क्लॉड के मौजूदा टूल्स सीधे वीडियो एक्सपोर्ट"
    },
    {
      "start": 134.06774193548387,
      "end": 137.23333333333332,
      "text": "न कर सकें, तो एडिटेबल प्रोजेक्ट लेकर लोकल"
    },
    {
      "start": 137.27956989247312,
      "end": 138.86989247311826,
      "text": "रेंडरर से फ़ाइल बनाएं।"
    },
    {
      "start": 139.02258064516127,
      "end": 141.5,
      "text": "इसी लिए हम रीमोशन इस्तेमाल कर रहे हैं।"
    },
    {
      "start": 141.5,
      "end": 141.5204301075269,
      "text": "इसी लिए हम रीमोशन इस्तेमाल कर रहे हैं।"
    },
    {
      "start": 141.66559139784945,
      "end": 143.91290322580645,
      "text": "एडिट बनने के बाद उसे शुरू से आखिर"
    },
    {
      "start": 143.95913978494625,
      "end": 147.0021505376344,
      "text": "तक देखें। जहाँ मकसद की बात है वहाँ"
    },
    {
      "start": 147.0784946236559,
      "end": 150.1525806451613,
      "text": "मकसद वाला कार्ड आए, नए कस्टमर्स का ज़िक्र"
    },
    {
      "start": 150.19784946236558,
      "end": 152.9279569892473,
      "text": "हो तो उसी की वज़ाहत दिखे, और टेस्टिंग"
    },
    {
      "start": 152.9741935483871,
      "end": 155.74946236559137,
      "text": "का ज़िक्र होते ही संबंधित ग्राफ़िक सामने आए।"
    },
    {
      "start": 156.09354838709677,
      "end": 158.34182795698925,
      "text": "मेरी आवाज़ के असल वक़्त के मुताबिक़ यह"
    },
    {
      "start": 158.38817204301074,
      "end": 159.69569892473115,
      "text": "बदलाव रखे गए हैं।"
    },
    {
      "start": 159.8096774193548,
      "end": 162.03548387096774,
      "text": "टेक्स्ट चेहरे के ऊपर न आए और पढ़ने"
    },
    {
      "start": 162.1043010752688,
      "end": 163.61612903225804,
      "text": "के लिए मुनासिब वक़्त मिले।"
    },
    {
      "start": 163.7763440860215,
      "end": 166.46021505376345,
      "text": "एडिट का प्रीव्यू चलना और वीडियो फ़ाइल बनना"
    },
    {
      "start": 166.52903225806452,
      "end": 167.68817204301072,
      "text": "दो अलग चरण हैं।"
    },
    {
      "start": 167.76774193548383,
      "end": 171.64516129032253,
      "text": "आखिर में असल एक्सपोर्ट खोलकर उसकी आवाज़, पूरा"
    },
    {
      "start": 171.71290322580646,
      "end": 174.86129032258063,
      "text": "ड्यूरेशन, फ़्रेम और कैप्शन चेक करें।"
    },
    {
      "start": 174.99247311827955,
      "end": 177.24053763440858,
      "text": "किसी और के रिज़ल्ट को अपना रिज़ल्ट न"
    },
    {
      "start": 177.33225806451614,
      "end": 180.29139784946236,
      "text": "कहें, और पाँच मिनट का दावा सिर्फ़ उसी"
    },
    {
      "start": 180.40645161290323,
      "end": 183.86236559139783,
      "text": "वक़्त करें जब आपने वक़्त ख़ुद नापा हो।"
    },
    {
      "start": 184.21397849462366,
      "end": 185.81182795698928,
      "text": "अब तैयार मिसाल देखते हैं।"
    },
    {
      "start": 186.34933333333333,
      "end": 186.47333333333333,
      "text": "اب"
    },
    {
      "start": 186.51333333333335,
      "end": 188.19333333333333,
      "text": "پورا ایڈٹ دیکھیں۔ اس میں"
    },
    {
      "start": 188.29333333333332,
      "end": 189.83333333333334,
      "text": "آواز میری ہے، پریزنٹر"
    },
    {
      "start": 189.89333333333335,
      "end": 191.11333333333334,
      "text": "بھی میرا اوتار ہے، اور"
    },
    {
      "start": 191.17333333333335,
      "end": 192.51333333333335,
      "text": "اسکرین پر آنے والی چیزیں"
    },
    {
      "start": 192.55333333333334,
      "end": 193.85333333333332,
      "text": "اسی وضاحت کو سپورٹ کرتی"
    },
    {
      "start": 193.89333333333335,
      "end": 194.01333333333335,
      "text": "ہیں۔"
    },
    {
      "start": 194.97333333333333,
      "end": 196.43333333333334,
      "text": "ایک اچھی کیمپین کا پلان"
    },
    {
      "start": 196.57333333333332,
      "end": 198.19333333333333,
      "text": "تب سمجھ آتا ہے جب ہر"
    },
    {
      "start": 198.23333333333332,
      "end": 199.43333333333334,
      "text": "فیصلے کی جگہ واضح ہو۔"
    },
    {
      "start": 200.13333333333333,
      "end": 201.11333333333334,
      "text": "پہلے سوچیں کہ آپ کو"
    },
    {
      "start": 201.19333333333333,
      "end": 202.89333333333332,
      "text": "نتیجہ کیا چاہیے، پھر یہ"
    },
    {
      "start": 202.93333333333334,
      "end": 204.29333333333332,
      "text": "طے کریں کہ کس تک پہنچنا"
    },
    {
      "start": 204.39333333333332,
      "end": 205.63333333333333,
      "text": "ہے اور اسے کیا پیغام"
    },
    {
      "start": 205.67333333333335,
      "end": 207.37333333333333,
      "text": "دکھانا ہے۔ اس مثال میں"
    },
    {
      "start": 207.37333333333333,
      "end": 208.83333333333334,
      "text": "ہم چار کام الگ رکھ رہے"
    },
    {
      "start": 208.87333333333333,
      "end": 210.33333333333334,
      "text": "ہیں: نئے کسٹمرز تک"
    },
    {
      "start": 210.37333333333333,
      "end": 212.19333333333333,
      "text": "پہنچنا، نئی کریئیٹو ٹیسٹ"
    },
    {
      "start": 212.23333333333332,
      "end": 214.07333333333332,
      "text": "کرنا، اچھی کارکردگی والے"
    },
    {
      "start": 214.11333333333334,
      "end": 215.33333333333334,
      "text": "اشتہارات کا جائزہ لینا،"
    },
    {
      "start": 215.83333333333334,
      "end": 217.01333333333332,
      "text": "اور موجودہ کسٹمرز سے"
    },
    {
      "start": 217.07333333333332,
      "end": 218.77333333333334,
      "text": "دوبارہ رابطہ کرنا۔ یہ"
    },
    {
      "start": 218.81333333333333,
      "end": 219.81333333333333,
      "text": "پلاننگ کی مثالیں ہیں،"
    },
    {
      "start": 220.13333333333333,
      "end": 221.31333333333333,
      "text": "بہتر نتائج کی گارنٹی"
    },
    {
      "start": 221.37333333333333,
      "end": 223.03333333333333,
      "text": "نہیں۔ چیزوں کے نام صاف"
    },
    {
      "start": 223.09333333333333,
      "end": 224.75333333333333,
      "text": "رکھیں، موازنہ کرتے وقت"
    },
    {
      "start": 224.81333333333333,
      "end": 225.81333333333333,
      "text": "ایک تبدیلی ٹیسٹ کریں،"
    },
    {
      "start": 226.23333333333332,
      "end": 227.43333333333334,
      "text": "اور نتیجہ اپنے مقصد کے"
    },
    {
      "start": 227.47333333333333,
      "end": 229.09333333333333,
      "text": "مطابق دیکھیں۔ ایک خوب"
    },
    {
      "start": 229.15333333333334,
      "end": 230.39333333333332,
      "text": "صورت ڈایاگرام پلان سمجھا"
    },
    {
      "start": 230.47333333333333,
      "end": 231.87333333333333,
      "text": "سکتا ہے، لیکن اصل ڈیٹا"
    },
    {
      "start": 231.93333333333334,
      "end": 232.97333333333333,
      "text": "کی جگہ نہیں لے سکتا۔"
    },
    {
      "start": 233.55333333333334,
      "end": 234.91333333333333,
      "text": "پہلے اسٹرکچر بنائیں، پھر"
    },
    {
      "start": 234.95333333333332,
      "end": 236.11333333333334,
      "text": "اسے دیکھیں اور بہتر"
    },
    {
      "start": 236.15333333333334,
      "end": 236.31333333333333,
      "text": "کریں۔"
    },
    {
      "start": 236.95066666666665,
      "end": 237.64666666666668,
      "text": "آخر میں فائل"
    },
    {
      "start": 237.68666666666664,
      "end": 239.08666666666667,
      "text": "ایکسپورٹ کرتے وقت آواز،"
    },
    {
      "start": 239.42666666666665,
      "end": 241.0066666666667,
      "text": "ٹیکسٹ، ٹائمنگ اور تصویر"
    },
    {
      "start": 241.10666666666665,
      "end": 242.80666666666664,
      "text": "ضرور چیک کریں۔ اے آئی"
    },
    {
      "start": 242.80666666666664,
      "end": 243.9466666666667,
      "text": "ایک ڈرافٹ تیزی سے بنا"
    },
    {
      "start": 244.02666666666667,
      "end": 245.5066666666667,
      "text": "سکتی ہے، لیکن ہر ویڈیو"
    },
    {
      "start": 245.58666666666667,
      "end": 246.94666666666663,
      "text": "کو انسانی نظر سے دیکھنا"
    },
    {
      "start": 246.98666666666665,
      "end": 249.0066666666667,
      "text": "ضروری ہے۔ یہی ورک فلو آپ"
    },
    {
      "start": 249.04666666666665,
      "end": 249.98666666666665,
      "text": "اپنی ویڈیوز کے لیے بھی"
    },
    {
      "start": 250.0066666666667,
      "end": 250.88666666666668,
      "text": "استعمال کر سکتے ہیں۔"
    }
  ]
}