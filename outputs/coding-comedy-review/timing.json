    {
      "startMs": 30510,
      "endMs": 31810,
      "text": "just to read my button?"
    },
    {
      "startMs": 31950,
      "endMs": 33400,
      "text": "And a verified email."
    },
    {
      "startMs": 33590,
      "endMs": 34250,
      "text": "Ah."
    },
    {
      "startMs": 36110,
      "endMs": 38020,
      "text": "Nobody connected the mail service."
    },
    {
      "startMs": 38170,
      "endMs": 39100,
      "text": "I'll handle that."
    },
    {
