  "captions": [
    {
      "startMs": 20,
      "endMs": 2540,
      "text": "Rename this button to Start, please."
    },
    {
      "startMs": 2800,
      "endMs": 3900,
      "text": "Already building."
    },
    {
      "startMs": 7100,
      "endMs": 8550,
      "text": "Twenty-four files?"
    },
    {
      "startMs": 8650,
      "endMs": 10090,
      "text": "I asked for one word."
    },
    {
      "startMs": 10250,
      "endMs": 11870,
      "text": "I added translation support."
    },
    {
      "startMs": 11990,
      "endMs": 13080,
      "text": "For one word?"
    },
    {
      "startMs": 13270,
      "endMs": 14190,
      "text": "Every button,"
    },
    {
      "startMs": 14290,
      "endMs": 15710,
      "text": "in thirty languages."
    },
    {
      "startMs": 17030,
      "endMs": 18490,
      "text": "This is a one-page demo."
    },
    {
      "startMs": 18630,
      "endMs": 19710,
      "text": "You can expand now."
    },
    {
      "startMs": 19910,
      "endMs": 21450,
      "text": "And this customer database?"
    },
    {
      "startMs": 21510,
      "endMs": 23240,
      "text": "It saves their preferred language."
    },
    {
      "startMs": 24710,
      "endMs": 26560,
      "text": "Fine. Show me Start."
    },
    {
      "startMs": 26680,
      "endMs": 28110,
      "text": "You'll need a profile first."
    },
    {
      "startMs": 29560,
      "endMs": 30470,
      "text": "A profile,"
